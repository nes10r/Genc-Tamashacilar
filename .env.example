# Real HR backend URL. Boş qalarsa portal daxili Demo API (mock) ilə işləyir.
VITE_API_URL=

# holidayapi.com açarı (yalnız Demo rejimi üçün; canlı rejimdə açar backend-də saxlanılır)
VITE_HOLIDAY_API_KEY=

# Google Calendar OAuth Client ID (Web application). Ayarlardan da daxil etmək olar.
VITE_GOOGLE_CLIENT_ID=
